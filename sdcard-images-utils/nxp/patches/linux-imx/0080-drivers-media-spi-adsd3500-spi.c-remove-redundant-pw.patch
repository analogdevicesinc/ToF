From eca7f5d2564eff20661d67de9ae09c77d7a2ea07 Mon Sep 17 00:00:00 2001
From: Sivasubramanaiyan Padmanaban <sivasubramaniyan.padmanaban@analog.com>
Date: Thu, 5 Nov 2026 14:28:43 +0530
Subject: [PATCH 1/3] drivers: media: spi: adsd3500-spi.c: remove redundant
 pwm_put() in remove()

- pwm_fsync is acquired via devm_pwm_get(), which registers a devres
  callback that automatically calls pwm_put() once remove() returns
- the explicit pwm_put(adsd3500->pwm_fsync) in adsd3500_remove() was
  therefore a double release of the same PWM device
- this manual pwm_put() was the trigger that cleared pwm-gpio's
  private chip_data on rmmod, causing a NULL dereference on the next
  modprobe of this driver

Signed-off-by: Sivasubramanaiyan Padmanaban <sivasubramaniyan.padmanaban@analog.com>
---
 drivers/media/spi/adsd3500-spi.c | 1 -
 1 file changed, 1 deletion(-)

diff --git a/drivers/media/spi/adsd3500-spi.c b/drivers/media/spi/adsd3500-spi.c
index aa8a7f5deb05..880b5f9e8fcf 100644
--- a/drivers/media/spi/adsd3500-spi.c
+++ b/drivers/media/spi/adsd3500-spi.c
@@ -2064,7 +2064,6 @@ static int adsd3500_remove(struct spi_device *client)
 	gpiod_put(adsd3500->irq_gpio);
 	debugfs_remove(adsd3500->debugfs);
 	v4l2_ctrl_handler_free(&adsd3500->ctrls);
-	pwm_put(adsd3500->pwm_fsync);
 	mutex_destroy(&adsd3500->lock);
 
 	pm_runtime_disable(adsd3500->dev);
-- 
2.25.1

